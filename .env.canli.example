# Postacı canlı/test ortamı ayarları. Bu dosyayı `.env.canli` adıyla kopyalayıp doldurun.
# `.env.canli` depoya GİRMEZ (.gitignore). Değerleri sohbete ya da e-postaya yapıştırmayın.
# Rastgele değer üretmek için:  openssl rand -base64 48

# --- Derlediğiniz imaj (YAYIN.md, 2. adım)
POSTACI_IMAGE=registry.example.com/postaci:test
POSTACI_PORT=4007

# --- Adresler (https ve gerçek alan adı; ters vekil bu adrese yönlendirir)
MAIN_URL=https://uygulama.ornek.com
FRONTEND_URL=https://uygulama.ornek.com
NEXT_PUBLIC_BACKEND_URL=https://uygulama.ornek.com/api
NEXT_PUBLIC_SITE_URL=https://ornek.com

# --- Gizli değerler (hepsi farklı ve uzun olmalı)
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=

# --- Kanal anahtarlarını şifreleme (ÜRETİMDE ZORUNLU; kaybolursa kanallar yeniden bağlanır, yedekleyin)
ENCRYPTION_PROVIDER=local
# openssl rand -base64 32
ENCRYPTION_KEY=
NODE_ENV=production

# --- Kayıt: kapatılırsa yalnızca mevcut hesaplar girer. İlk hesabı açtıktan sonra true yapabilirsiniz.
DISABLE_REGISTRATION=false

# --- E-posta (Plesk posta kutusu olabilir). EMAIL_PROVIDER dolu ise kullanıcı e-posta ile etkinleştirme ister.
EMAIL_PROVIDER=nodemailer
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# --- iyzico (sandbox ile başlayın; canlıya geçerken webhook imzasını açtırıp IYZICO_MERCHANT_ID girin)
PAYMENT_PROVIDER_WEB=iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MERCHANT_ID=

# --- Faturalama kipi için yer tutucular (boş olmamalı, gerçek Stripe kullanılmıyor)
STRIPE_PUBLISHABLE_KEY=unused
STRIPE_SECRET_KEY=unused
STRIPE_SIGNING_KEY=unused
STRIPE_SIGNING_KEY_CONNECT=unused

# --- Google ile giriş (boş bırakılırsa "Google ile devam et" düğmesi görünmez).
# Giriş için ayrı bir Google OAuth istemcisi önerilir (yalnızca profil ve e-posta izni; YouTube'un
# hassas izinleri için gereken Google doğrulamasına bağlı kalmaz). Boşsa YOUTUBE_CLIENT_ID kullanılır.
# Google'da izinli yönlendirme adresi: <FRONTEND_URL>/integrations/social/youtube
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# --- Sosyal ağ uygulama anahtarları (kullanacaklarınızı doldurun; bkz. .env.example)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
